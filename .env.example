# =============================================================================
# Шаблон переменных окружения для запуска БЕЗ Docker (host machine).
# Для docker compose значения переопределяются в docker-compose.yml.
# Скопируй в .env и поправь под свою машину.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL master (WRITE) — hw1+
# -----------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=social_network

# -----------------------------------------------------------------------------
# PostgreSQL slaves (READ) — hw3, через запятую host:port
# -----------------------------------------------------------------------------
DATABASE_SLAVE_HOSTS=localhost:5433,localhost:5434
DATABASE_POOL_MIN_SIZE=5
DATABASE_POOL_MAX_SIZE=50

# -----------------------------------------------------------------------------
# JWT — hw1
# -----------------------------------------------------------------------------
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# Redis — hw4 (кэш ленты постов)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
FEED_MAX_SIZE=1000

# Async fan-out через Redis Streams (hw4 Phase 7) — выключено по умолчанию
FEED_FANOUT_ASYNC=false
FEED_STREAM_KEY=post_events
FEED_STREAM_GROUP=feed_workers
FEED_STREAM_CONSUMER=worker-1
FEED_STREAM_BLOCK_MS=5000
FEED_STREAM_BATCH=100

# -----------------------------------------------------------------------------
# Dialogs sharding — hw5 (список DSN шардов через запятую, порядок = shard_id)
# -----------------------------------------------------------------------------
DIALOGS_SHARDS=postgresql://postgres:postgres@localhost:5440/dialogs,postgresql://postgres:postgres@localhost:5441/dialogs
DIALOGS_POOL_MIN_SIZE=2
DIALOGS_POOL_MAX_SIZE=10

# Resharding feature-flags (0 = "как len(SHARDS)")
DIALOGS_READ_N=0
DIALOGS_WRITE_N=0
DIALOGS_DUAL_WRITE=false

# -----------------------------------------------------------------------------
# Realtime feed (hw6) — WebSocket + RabbitMQ
# feed_transport: "redis_streams" (hw4) или "rabbitmq" (hw6)
# -----------------------------------------------------------------------------
FEED_TRANSPORT=rabbitmq
RABBITMQ_URL=amqp://guest:guest@localhost:5673/
RABBITMQ_EXCHANGE=posts.events
RABBITMQ_MATERIALIZE_QUEUE=feed.materialize
RABBITMQ_MATERIALIZE_ROUTING_KEY=feed.materialize
RABBITMQ_USER_ROUTING_PREFIX=feed.user
RABBITMQ_PREFETCH=16

# Lady Gaga effect (hw6): порог followers, выше которого push-fan-out пропускается
CELEBRITY_FOLLOWERS_THRESHOLD=10000
CELEBRITY_CACHE_TTL=300

# WebSocket heartbeat
WS_HEARTBEAT_INTERVAL_S=25
WS_IDLE_TIMEOUT_S=60

# -----------------------------------------------------------------------------
# Dialogs backend (hw7) — переключатель A/B-бенчмарка PG vs Tarantool
#   postgres   — шардированный Citus-кластер (hw5)
#   tarantool  — in-memory СУБД с UDF на Lua (hw7)
# -----------------------------------------------------------------------------
DIALOGS_BACKEND=postgres
TARANTOOL_HOST=localhost
TARANTOOL_PORT=3301
TARANTOOL_RECONNECT_TIMEOUT=1.0
